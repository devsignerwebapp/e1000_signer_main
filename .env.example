NODE_ENV=development
PORT=4000
APP_NAME=E1000Signer

API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=signer
DB_USER=postgres
DB_PASSWORD=
# true for Supabase / hosted Postgres (TLS). For Supabase use the Session Pooler host
# (aws-0-<region>.pooler.supabase.com, user postgres.<project-ref>) unless your network has IPv6.
DB_SSL=false

# local | supabase
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=data-files

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E1000Signer <you@example.com>"
# Email on/off. false = no emails at all (e.g. Render free plan): the confirmation code is always
# OTP_FALLBACK_CODE (shown on screen), password reset by email is disabled. Set true to re-enable.
MAIL_ENABLED=true
OTP_FALLBACK_CODE=0000
# Optional: sender for verification/reset codes, e.g. "E1000Signer Confirm <confirm@yourdomain.com>"
# (default: MAIL_FROM's address with the name "E1000Signer Confirm")
MAIL_FROM_CONFIRM=
# Optional: where replies go, e.g. support@yourdomain.com
MAIL_REPLY_TO=
# smtp | brevo | resend. Render's FREE plan blocks SMTP ports → use brevo (or resend) there.
MAIL_TRANSPORT=smtp
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_TIMEOUT_MS=15000

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=E1000 Admin

MAX_UPLOAD_MB=20
STORAGE_DIR=./storage
